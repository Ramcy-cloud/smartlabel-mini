# Origines autorisées à appeler l'API depuis un navigateur (CORS).
# Liste séparée par des virgules, espaces ignorés. "*" est refusé.
# Par défaut (variable absente) : http://localhost:5175,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173

# Noms d'hôte acceptés par l'API, séparés par des virgules (protège contre les en-têtes Host forgés).
# Par défaut : localhost,127.0.0.1 — à remplacer par votre nom de domaine en déploiement.
ALLOWED_HOSTS=localhost,127.0.0.1

# Nombre maximal de requêtes d'IA (/predict, /triage) par minute et par adresse IP.
RATE_LIMIT_PER_MINUTE=60

# Durée de validité d'une session après connexion, en heures (ramenée entre 1 et 168).
# Passé ce délai le jeton est refusé et il faut se reconnecter.
SESSION_TTL_HOURS=12

# Documentation interactive de l'API (/docs, /redoc, /openapi.json). Laissez vide : elle est
# accessible sans connexion et révèle tout le schéma de l'API. Mettez 1 seulement en développement.
ENABLE_DOCS=

# Identifiants de connexion à l'application (un compte partagé par l'équipe).
# OBLIGATOIRES : si l'un des deux est vide, personne ne peut se connecter.
# Choisissez un mot de passe long et unique. Ce fichier est un modèle : mettez les vraies valeurs
# dans un fichier .env (ignoré par Git) à la racine pour Docker, ou dans backend/.env sans Docker.
APP_EMAIL=
APP_PASSWORD=

# --- Moteurs de classification -------------------------------------------------
# Moteur Mistral (cloud), OPTIONNEL et désactivé par défaut. Laissez vide pour garder tout en local.
# Si vous renseignez une clé, les textes des tickets sont envoyés à Mistral (emails, téléphones, IBAN,
# cartes et liens masqués, mais pas les noms ni les adresses). Ne mettez JAMAIS la clé dans le code ni dans Git.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Phrase testée par le modèle local pour chaque catégorie ({} = la catégorie ou sa description).
# HYPOTHESIS_TEMPLATE=Ce texte concerne : {}.

# Dossier des modèles entraînés sur vos tickets (python -m tools.train). Par défaut : backend/data/models
# MODELS_DIR=

# --- Frontend ------------------------------------------------------------------
# Adresse de l'API utilisée par le frontend, figée au moment de la construction.
# Par défaut : http://127.0.0.1:8000/api (backend sur la même machine).
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Origine du backend autorisée par la politique de sécurité du contenu servie par nginx.
# Doit correspondre à l'origine de VITE_API_BASE_URL, sans le chemin /api.
API_ORIGIN=http://127.0.0.1:8000
