# Origines autorisées à appeler l'API depuis un navigateur (CORS).
# Liste séparée par des virgules, espaces ignorés. "*" est refusé.
# Par défaut (variable absente) : http://localhost:5175,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173

# Noms d'hôte acceptés par l'API, séparés par des virgules (protège contre les en-têtes Host forgés).
# Par défaut : localhost,127.0.0.1 — à remplacer par votre nom de domaine en déploiement.
ALLOWED_HOSTS=localhost,127.0.0.1

# Nombre maximal de requêtes d'IA (/predict, /triage) par minute et par adresse IP.
RATE_LIMIT_PER_MINUTE=60
